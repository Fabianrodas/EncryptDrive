<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root"
      spacing="12.0"
      styleClass="page-content"
      stylesheets="@../css/workspace.css"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fabianrodas.encryptdrive.FilesController">

    <children>
        <VBox spacing="5.0">
            <children>
                <Label styleClass="page-title" text="Files" />

                <Label styleClass="page-subtitle"
                       text="Every file is encrypted with its own key before it is stored." />
            </children>
        </VBox>

        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <children>
                <HBox fx:id="breadcrumbBar"
                      alignment="CENTER_LEFT"
                      minWidth="0.0"
                      spacing="2.0"
                      HBox.hgrow="ALWAYS" />

                <Button fx:id="newFolderButton"
                        minWidth="-Infinity"
                        mnemonicParsing="false"
                        onAction="#newFolder"
                        prefHeight="36.0"
                        styleClass="secondary-button"
                        text="New Folder" />

                <Button fx:id="importButton"
                        minWidth="-Infinity"
                        mnemonicParsing="false"
                        onAction="#importFiles"
                        prefHeight="36.0"
                        styleClass="primary-button"
                        text="Import Files" />

                <Button fx:id="exportButton"
                        disable="true"
                        minWidth="-Infinity"
                        mnemonicParsing="false"
                        onAction="#export"
                        prefHeight="36.0"
                        styleClass="secondary-button"
                        text="Export" />

                <Button fx:id="renameButton"
                        disable="true"
                        minWidth="-Infinity"
                        mnemonicParsing="false"
                        onAction="#rename"
                        prefHeight="36.0"
                        styleClass="secondary-button"
                        text="Rename" />

                <Button fx:id="trashButton"
                        disable="true"
                        minWidth="-Infinity"
                        mnemonicParsing="false"
                        onAction="#moveToTrash"
                        prefHeight="36.0"
                        styleClass="danger-button"
                        text="Move to Trash" />
            </children>
        </HBox>

        <HBox fx:id="progressBox"
              alignment="CENTER_LEFT"
              managed="false"
              spacing="10.0"
              visible="false">
            <children>
                <ProgressBar fx:id="progressBar" prefWidth="220.0" progress="0.0" />
                <Label fx:id="progressLabel" styleClass="page-subtitle" />
            </children>
        </HBox>

        <Label fx:id="feedbackLabel"
               minHeight="16.0"
               styleClass="feedback-label"
               wrapText="true" />

        <TableView fx:id="table" styleClass="file-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="nameColumn" prefWidth="320.0" sortable="false" text="NAME" />
                <TableColumn fx:id="typeColumn" prefWidth="120.0" sortable="false" text="TYPE" />
                <TableColumn fx:id="sizeColumn" prefWidth="100.0" sortable="false" text="SIZE" />
                <TableColumn fx:id="modifiedColumn" prefWidth="150.0" sortable="false" text="MODIFIED" />
            </columns>

            <placeholder>
                <Label text="This folder is empty. Import files or create a folder." />
            </placeholder>
        </TableView>
    </children>
</VBox>
