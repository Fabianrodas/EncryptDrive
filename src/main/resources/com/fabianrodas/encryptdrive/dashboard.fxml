<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root"
            minHeight="600.0"
            minWidth="1000.0"
            prefHeight="600.0"
            prefWidth="1000.0"
            styleClass="dashboard-root"
            stylesheets="@../css/dashboard.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fabianrodas.encryptdrive.DashboardController">

    <top>
        <HBox alignment="CENTER_RIGHT"
              onMouseDragged="#dragWindow"
              onMousePressed="#beginDrag"
              prefHeight="38.0"
              styleClass="title-bar">

            <children>
                <Label styleClass="window-name" text="EncryptDrive" />

                <Region HBox.hgrow="ALWAYS" />

                <Button id="minimize"
                        focusTraversable="false"
                        mnemonicParsing="false"
                        onAction="#minimize"
                        styleClass="window-control"
                        text="−" />

                <Button id="maximize"
                        focusTraversable="false"
                        mnemonicParsing="false"
                        onAction="#toggleMaximize"
                        styleClass="window-control"
                        text="□" />

                <Button id="close"
                        focusTraversable="false"
                        mnemonicParsing="false"
                        onAction="#close"
                        styleClass="window-control"
                        text="×" />
            </children>
        </HBox>
    </top>

    <center>
        <HBox>
            <children>
                <VBox fx:id="sidebar"
                      spacing="12.0"
                      styleClass="sidebar">

                    <children>
                        <HBox alignment="CENTER_LEFT"
                              spacing="10.0"
                              styleClass="sidebar-brand">

                            <children>
                                <StackPane styleClass="sidebar-logo-badge">
                                    <children>
                                        <ImageView fitHeight="30.0"
                                                   fitWidth="30.0"
                                                   preserveRatio="true">
                                            <image>
                                                <Image url="@../images/logo.png" />
                                            </image>
                                        </ImageView>
                                    </children>
                                </StackPane>

                                <VBox spacing="1.0">
                                    <children>
                                        <Label styleClass="sidebar-brand-name"
                                               text="EncryptDrive" />

                                        <Label styleClass="sidebar-brand-subtitle"
                                               text="LOCAL WORKSPACE" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <VBox spacing="4.0">
                            <children>
                                <Label styleClass="sidebar-section-label"
                                       text="WORKSPACE" />

                                <Button fx:id="overviewNavButton"
                                        maxWidth="1.7976931348623157E308"
                                        mnemonicParsing="false"
                                        onAction="#showOverview"
                                        prefHeight="38.0"
                                        styleClass="sidebar-nav-button"
                                        text="Overview" />

                                <Button fx:id="filesNavButton"
                                        maxWidth="1.7976931348623157E308"
                                        mnemonicParsing="false"
                                        onAction="#showFiles"
                                        prefHeight="38.0"
                                        styleClass="sidebar-nav-button"
                                        text="Files" />

                                <Button fx:id="trashNavButton"
                                        maxWidth="1.7976931348623157E308"
                                        mnemonicParsing="false"
                                        onAction="#showTrash"
                                        prefHeight="38.0"
                                        styleClass="sidebar-nav-button"
                                        text="Trash" />

                                <Button fx:id="profileNavButton"
                                        maxWidth="1.7976931348623157E308"
                                        mnemonicParsing="false"
                                        onAction="#showProfile"
                                        prefHeight="38.0"
                                        styleClass="sidebar-nav-button"
                                        text="Personal Profile" />

                                <Button fx:id="settingsNavButton"
                                        maxWidth="1.7976931348623157E308"
                                        mnemonicParsing="false"
                                        onAction="#showSettings"
                                        prefHeight="38.0"
                                        styleClass="sidebar-nav-button"
                                        text="Vault Settings" />
                            </children>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS" />

                        <HBox alignment="CENTER_LEFT"
                              spacing="10.0"
                              styleClass="sidebar-user-card">
                            <children>
                                <StackPane styleClass="sidebar-avatar">
                                    <children>
                                        <Label fx:id="sidebarInitialsLabel"
                                               styleClass="sidebar-avatar-text"
                                               text="U" />
                                    </children>
                                </StackPane>

                                <VBox spacing="2.0">
                                    <children>
                                        <Label fx:id="sidebarFullNameLabel"
                                               styleClass="sidebar-user-name"
                                               text="User" />

                                        <Label fx:id="sidebarUsernameLabel"
                                               styleClass="sidebar-user-username"
                                               text="@username" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <VBox spacing="6.0">
                            <children>
                                <Button fx:id="logoutButton"
                                        maxWidth="1.7976931348623157E308"
                                        mnemonicParsing="false"
                                        onAction="#logout"
                                        prefHeight="38.0"
                                        styleClass="logout-button"
                                        text="Log Out" />

                                <Button fx:id="closeVaultButton"
                                        maxWidth="1.7976931348623157E308"
                                        mnemonicParsing="false"
                                        onAction="#closeVault"
                                        prefHeight="38.0"
                                        styleClass="close-vault-button"
                                        text="Close Vault" />
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <StackPane fx:id="contentHost"
                           styleClass="content-host"
                           HBox.hgrow="ALWAYS" />
            </children>
        </HBox>
    </center>
</BorderPane>
